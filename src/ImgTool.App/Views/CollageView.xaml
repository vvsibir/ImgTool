<UserControl x:Class="ImgTool.App.Views.CollageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="1160"
             AllowDrop="True"
             Drop="OnFileDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Коллаж" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Соберите изображения в сетку или склейте их в вертикальную либо горизонтальную полосу."
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Параметры коллажа" Style="{StaticResource CardTitle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Результат" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                            <TextBlock Text="Файл коллажа" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource SmallButton}"
                                        Command="{Binding BrowseOutputCommand}" />
                            </Grid>

                            <TextBlock Text="Раскладка" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <ComboBox ItemsSource="{Binding Layouts}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Layout}" />

                            <TextBlock Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding IsStripLayout, Converter={StaticResource BoolToVis}}"
                                       Text="Кадры склеиваются без масштабирования. Ширина вертикальной полосы — по самому широкому кадру, высота горизонтальной — по самому высокому." />

                            <Grid Margin="0,12,0,0" IsEnabled="{Binding IsGridLayout}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Колонок" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ширина, px (пусто — авто)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                             ToolTip="Оставьте поле пустым — ширина ячейки будет равна ширине первого изображения, а итоговая ширина рассчитается по числу колонок" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Пропорция ячейки" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CellAspect, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsGridLayout}"
                                             ToolTip="1 — квадрат, 1.5 — шире, 0.75 — выше" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Формат" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Formats}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Format}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Отступ между, px" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Spacing, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Поле вокруг, px" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel IsEnabled="{Binding IsGridLayout}">
                                <TextBlock Text="Режим заполнения" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <ComboBox ItemsSource="{Binding Fits}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Fit}" />
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Цвет фона (HEX)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsBackgroundColorEnabled}"
                                             ToolTip="Поддерживает #RGB, #RRGGBB и #AARRGGBB" />
                                    <CheckBox Content="Прозрачный фон (PNG/WebP)"
                                              IsChecked="{Binding TransparentBackground}"
                                              IsEnabled="{Binding SupportsTransparentBackground}"
                                              Margin="0,8,0,0"
                                              ToolTip="Доступно только для PNG и WebP" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Height="36"
                                        Margin="0,20,0,0"
                                        CornerRadius="8"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Background="{Binding BackgroundHex}"
                                        IsEnabled="{Binding IsBackgroundColorEnabled}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Качество" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Quality, StringFormat={}{0}%}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </Grid>
                            <Slider Minimum="1" Maximum="100"
                                    Value="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Подсказка" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Порядок изображений определяет их расположение слева направо и сверху вниз. Используйте стрелки, чтобы изменить порядок. В режиме склейки кадры сохраняют исходный размер, а фон заполняет свободное место. Если ширина сетки не задана, она рассчитывается по ширине первого изображения и числу колонок. Для PNG и WebP фон можно сделать прозрачным." />
                            <Border Height="16" Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Изображения" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding FilesCountText}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="+ Файлы" Style="{StaticResource SmallButton}" Command="{Binding AddFilesCommand}" />
                                <Button Content="+ Папка" Style="{StaticResource SmallButton}" Command="{Binding AddFolderCommand}" Margin="6,0,0,0" />
                                <Button Content="↑" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}" Margin="6,0,0,0" ToolTip="Переместить выше" />
                                <Button Content="↓" Style="{StaticResource SmallButton}" Command="{Binding MoveDownCommand}" Margin="6,0,0,0" ToolTip="Переместить ниже" />
                                <Button Content="Удалить" Style="{StaticResource SmallButton}" Command="{Binding RemoveSelectedCommand}" Margin="6,0,0,0" />
                                <Button Content="Очистить" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                        Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding SelectedFile}"
                                     SelectionMode="Single"
                                     AllowDrop="True"
                                     Drop="OnFileDrop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}"
                                                           FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource ValueText}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}"
                                                           FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Перетащите изображения сюда или добавьте их кнопками выше."
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="340"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Предпросмотр" Style="{StaticResource CardTitle}" />
                        <Border Grid.Row="1" Background="#0C111B" CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding PreviewSource}" Stretch="Uniform" Margin="10" />
                                <TextBlock Text="Здесь появится выбранное изображение или готовый коллаж"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="320"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,18,0" />

                <ProgressBar Grid.Column="1"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Отмена" Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Content="Собрать коллаж" Style="{StaticResource AccentButton}"
                            Command="{Binding BuildCommand}" Padding="26,9" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
