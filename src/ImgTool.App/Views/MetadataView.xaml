<UserControl x:Class="ImgTool.App.Views.MetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="1160"
             AllowDrop="True"
             Drop="OnFileDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Метаданные" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Просмотр EXIF и GPS, удаление метаданных и переименование по дате съёмки."
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Файлы" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding FilesCountText}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="+ Файлы" Style="{StaticResource SmallButton}" Command="{Binding AddFilesCommand}" />
                            <Button Content="+ Папка" Style="{StaticResource SmallButton}" Command="{Binding AddFolderCommand}" Margin="6,0,0,0" />
                            <Button Content="Очистить" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                    Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,10" />

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile}"
                                 SelectionMode="Single"
                                 AllowDrop="True"
                                 Drop="OnFileDrop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8"
                                                Background="{StaticResource AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Extension}"
                                                       FontSize="8.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ValueText}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}"
                                                       FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Перетащите файлы или папки сюда, чтобы прочитать метаданные."
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сведения о файле" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedFile.Name}" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SummaryDimensions}" Style="{StaticResource ValueText}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Формат" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SummaryFormat}" Style="{StaticResource ValueText}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Вес файла" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SummarySize}" Style="{StaticResource ValueText}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Дата съёмки" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SummaryDate}" Style="{StaticResource ValueText}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Метаданные" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SummaryHasMetadata}" Style="{StaticResource ValueText}" FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="EXIF и GPS" Style="{StaticResource CardTitle}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding ExifEntries}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontSize="12.5"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Выберите файл слева"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Шаблон:" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RenamePattern, UpdateSourceTrigger=PropertyChanged}"
                             Width="210" Margin="8,0,0,0"
                             ToolTip="Поддерживает {date}, {time}, {name}, {ext}" />
                    <Button Content="Переименовать по дате" Style="{StaticResource GhostButton}"
                            Command="{Binding RenameCommand}" Margin="10,0,0,0" />
                    <Button Content="Удалить метаданные" Style="{StaticResource DangerButton}"
                            Command="{Binding RemoveMetadataCommand}" Margin="8,0,0,0" />
                    <Button Content="Обновить" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <ProgressBar Grid.Column="1"
                             Width="130"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
