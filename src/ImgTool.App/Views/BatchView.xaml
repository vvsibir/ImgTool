<UserControl x:Class="ImgTool.App.Views.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="1160"
             AllowDrop="True"
             Drop="OnFileDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Пакетная обработка" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Ресайз, обрезка, поворот, конвертация и водяные знаки для группы файлов."
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="372" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Параметры" Style="{StaticResource CardTitle}" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Сохранение" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                            <TextBlock Text="Папка результата" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Пусто — сохранять рядом с исходным файлом" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource SmallButton}"
                                        Command="{Binding BrowseOutputCommand}" />
                            </Grid>

                            <TextBlock Text="Шаблон имени" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Поддерживает {name}, {ext}, {index}, {date}, {width}, {height}, {format}" />

                            <TextBlock Text="Формат" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <ComboBox ItemsSource="{Binding Formats}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Format}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Качество" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Quality, StringFormat={}{0}%}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </Grid>
                            <Slider Minimum="1" Maximum="100"
                                    Value="{Binding Quality, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding QualityEnabled}" />

                            <TextBlock Text="При совпадении имён" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <ComboBox ItemsSource="{Binding CollisionPolicies}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding CollisionPolicy}" />

                            <CheckBox Content="Сохранять метаданные (JPEG)"
                                      IsChecked="{Binding PreserveMetadata}"
                                      Margin="0,14,0,0" />

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Размер" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />

                            <CheckBox Content="Изменить размер" IsChecked="{Binding ResizeEnabled}" />
                            <StackPanel IsEnabled="{Binding ResizeEnabled}" Margin="0,10,0,0">
                                <ComboBox ItemsSource="{Binding ResizeModes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ResizeMode}" />

                                <Grid Margin="0,10,0,0" IsEnabled="{Binding IsBoxResize}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ширина, px" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Высота, px" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsPercentResize}">
                                    <TextBlock Text="Процент, %" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding ResizePercent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <CheckBox Content="Не увеличивать изображения"
                                          IsChecked="{Binding DontUpscale}"
                                          Margin="0,10,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Обрезка и поворот" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />

                            <CheckBox Content="Обрезать кадры" IsChecked="{Binding CropEnabled}" />
                            <StackPanel IsEnabled="{Binding CropEnabled}" Margin="0,10,0,0">
                                <TextBlock Text="Способ обрезки" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding CropModes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding CropMode}" />

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsAspectCrop, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Пропорция, ширина" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropAspectWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Пропорция, высота" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropAspectHeight, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Привязка обрезки" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                    <ComboBox ItemsSource="{Binding Anchors}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding CropAnchor}" />
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsCropUnitVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Единицы измерения" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding CropUnits}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding CropUnit}" />
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsMarginsCrop, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Слева" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropMarginLeft, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Сверху" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropMarginTop, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Справа" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropMarginRight, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Снизу" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropMarginBottom, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Одинаковые поля применяются ко всем кадрам. В процентах поля считаются от ширины и высоты каждого изображения." />
                                </StackPanel>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsRectangleCrop, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropRectangleX, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Y" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropRectangleY, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Ширина" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropRectangleWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Высота" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CropRectangleHeight, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Отсчёт от левого верхнего угла. Обрезается один и тот же прямоугольник на каждом кадре." />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Поворот" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <ComboBox ItemsSource="{Binding Rotations}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding RotationDegrees}" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Content="Отразить по горизонтали" IsChecked="{Binding FlipHorizontal}" />
                                <CheckBox Content="По вертикали" IsChecked="{Binding FlipVertical}" Margin="16,0,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Хромакей" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />

                            <CheckBox Content="Удалить фон по цвету" IsChecked="{Binding ChromaKeyEnabled}" />
                            <StackPanel IsEnabled="{Binding ChromaKeyEnabled}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Цвет ключа (HEX)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ChromaKeyColor, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Height="36"
                                            Margin="0,20,0,0"
                                            CornerRadius="8"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Background="{Binding ChromaKeyColor}" />
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Допуск" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ChromaKeyTolerance, StringFormat={}{0:0}%}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100"
                                        Value="{Binding ChromaKeyTolerance, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Смягчение" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ChromaKeySoftness, StringFormat={}{0:0}%}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12" />
                                </Grid>
                                <Slider Minimum="0" Maximum="100"
                                        Value="{Binding ChromaKeySoftness, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox Content="Убирать цветной ореол"
                                          IsChecked="{Binding ChromaKeyDespill}"
                                          Margin="0,8,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Фон для JPEG/BMP (HEX)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ChromaKeyBackground, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Height="36"
                                            Margin="0,20,0,0"
                                            CornerRadius="8"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            Background="{Binding ChromaKeyBackground}" />
                                </Grid>

                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="PNG и WebP сохраняют прозрачность, JPEG и BMP — на выбранном фоне. Если фон удаляется не полностью, увеличьте допуск; если удаляются лишние области — уменьшите." />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Водяной знак" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />

                            <CheckBox Content="Добавить водяной знак" IsChecked="{Binding WatermarkEnabled}" />
                            <StackPanel IsEnabled="{Binding WatermarkEnabled}" Margin="0,10,0,0">
                                <ComboBox ItemsSource="{Binding WatermarkKinds}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding WatermarkKind}" />

                                <StackPanel Visibility="{Binding IsTextWatermark, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="Текст" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Шрифт" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding WatermarkFont, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Размер" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding WatermarkFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Цвет (HEX)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding WatermarkColor, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Height="36"
                                                Margin="0,20,0,0"
                                                CornerRadius="8"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{Binding WatermarkColor}" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Прозрачность" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding WatermarkOpacity, StringFormat={}{0:P0}}"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding WatermarkOpacity, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Позиция" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <ComboBox ItemsSource="{Binding Anchors}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding WatermarkPosition}" />

                                    <TextBlock Text="Отступ, px" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <TextBox Text="{Binding WatermarkMargin, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox Content="Добавить тень" IsChecked="{Binding WatermarkShadow}" Margin="0,10,0,0" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsLogoWatermark, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="Файл логотипа" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding WatermarkLogoPath}" IsReadOnly="True" />
                                        <Button Grid.Column="2" Content="Выбрать" Style="{StaticResource SmallButton}"
                                                Command="{Binding BrowseLogoCommand}" />
                                    </Grid>

                                    <TextBlock Text="Ширина логотипа, %" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                    <TextBox Text="{Binding WatermarkLogoWidth, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Подсказка" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Поддерживаются JPG, PNG, BMP и WebP. Обрезка и хромакей выполняются после поворота и отражения, но до изменения размера. Водяной знак рисуется после изменения размера. Для JPEG метаданные переносятся с исправленной ориентацией." />
                            <Border Height="16" Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Изображения" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding FilesCountText}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="+ Файлы" Style="{StaticResource SmallButton}" Command="{Binding AddFilesCommand}" />
                                <Button Content="+ Папка" Style="{StaticResource SmallButton}" Command="{Binding AddFolderCommand}" Margin="6,0,0,0" />
                                <Button Content="Удалить" Style="{StaticResource SmallButton}" Command="{Binding RemoveSelectedCommand}" Margin="6,0,0,0" />
                                <Button Content="Очистить" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                        Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Grid.Row="1" Content="Включать подпапки при добавлении папки"
                                  IsChecked="{Binding RecursiveFolders}"
                                  Margin="0,10,0,4" />

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <ListBox ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding SelectedFile}"
                                     SelectionMode="Single"
                                     AllowDrop="True"
                                     Drop="OnFileDrop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}"
                                                           FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource ValueText}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}"
                                                           FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Перетащите файлы или папки сюда, либо нажмите «+ Файлы»."
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Предпросмотр" Style="{StaticResource CardTitle}" />
                            <Border Grid.Row="1" Background="#0C111B" CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PreviewSource}" Stretch="Uniform" Margin="8" />
                                    <TextBlock Text="Выберите изображение"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Журнал" Style="{StaticResource CardTitle}" Margin="0" />
                                <Button Grid.Column="1" Content="Открыть папку" Style="{StaticResource SmallButton}"
                                        Command="{Binding OpenOutputFolderCommand}" />
                            </Grid>
                            <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Log}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="6,3" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="#B7C2D8" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,18,0" />

                <ProgressBar Grid.Column="1"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Отмена" Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Content="Обработать" Style="{StaticResource AccentButton}"
                            Command="{Binding RunCommand}" Padding="26,9" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
