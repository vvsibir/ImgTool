<UserControl x:Class="ImgTool.App.Views.GifView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="1160"
             AllowDrop="True"
             Drop="OnFileDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="GIF → кадры" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Извлеките все кадры анимированного GIF в отдельные изображения."
                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Параметры извлечения" Style="{StaticResource CardTitle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Результат" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                            <TextBlock Text="Папка для кадров" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Оставьте поле пустым, чтобы сохранить кадры рядом с каждым GIF" />
                                <Button Grid.Column="2" Content="Обзор" Style="{StaticResource SmallButton}"
                                        Command="{Binding BrowseOutputCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Text="Пустое поле — кадры сохраняются рядом с исходным GIF." />

                            <TextBlock Text="Формат кадров" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                            <ComboBox ItemsSource="{Binding Formats}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Format}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Качество" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Quality, StringFormat={}{0}%}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </Grid>
                            <Slider Minimum="1" Maximum="100"
                                    IsEnabled="{Binding QualityEnabled}"
                                    Value="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Шаблон имени" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Text="Подстановки: {name}, {index}, {ext}, {date}, {width}, {height}. Нумерация кадров начинается с 1." />

                            <TextBlock Text="При совпадении" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                            <ComboBox ItemsSource="{Binding CollisionPolicies}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding CollisionPolicy}" />

                            <CheckBox Content="Добавлять папки рекурсивно"
                                      IsChecked="{Binding RecursiveFolders}"
                                      Margin="0,14,0,0" />

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,0" />
                            <TextBlock Text="Прозрачность" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="PNG и WebP сохраняют прозрачные области GIF. JPEG и BMP записываются на белом фоне. Кадры собираются с учётом смешивания и очистки предыдущих кадров." />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Для очень длинных GIF извлечение всех кадров может занять заметное время." />
                            <Border Height="16" Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GIF-файлы" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding FilesCountText}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="+ Файлы" Style="{StaticResource SmallButton}" Command="{Binding AddFilesCommand}" />
                                <Button Content="+ Папка" Style="{StaticResource SmallButton}" Command="{Binding AddFolderCommand}" Margin="6,0,0,0" />
                                <Button Content="Удалить" Style="{StaticResource SmallButton}" Command="{Binding RemoveSelectedCommand}" Margin="6,0,0,0" />
                                <Button Content="Очистить" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                        Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding SelectedFile}"
                                     SelectionMode="Single"
                                     AllowDrop="True"
                                     Drop="OnFileDrop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}"
                                                           FontSize="8.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource ValueText}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}"
                                                           FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Перетащите GIF или папку сюда либо добавьте их кнопками выше."
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="340"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Предпросмотр первого кадра" Style="{StaticResource CardTitle}" />
                            <Border Grid.Row="1" Background="#0C111B" CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PreviewSource}" Stretch="Uniform" Margin="10" />
                                    <TextBlock Text="Выберите GIF, чтобы увидеть его первый кадр"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="280"
                                               TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Журнал" Style="{StaticResource CardTitle}" Margin="0" />
                                <Button Grid.Column="1" Content="Открыть папку" Style="{StaticResource SmallButton}"
                                        Command="{Binding OpenOutputFolderCommand}" />
                            </Grid>
                            <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Log}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="6,3" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="#B7C2D8" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           MaxWidth="520"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,18,0" />

                <ProgressBar Grid.Column="1"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Margin="0,0,20,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Отмена" Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Content="Извлечь кадры" Style="{StaticResource AccentButton}"
                            Command="{Binding ExtractCommand}" Padding="26,9" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
